def linear_search(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1

arr = [83, 13, 24, 95, 7, 143, 77]
target = 13
result = linear_search(arr, target)
if result != -1:
    print(f"Linear Search: Element found at index {result}")
else:
    print("Linear Search: Element not found")

def binary_search(arr, target, low, high):
    if low <= high:
        mid = (low + high) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            return binary_search(arr, target, mid + 1, high)
        else:
            return binary_search(arr, target, low, mid - 1)
    return -1

arr2 = [812, 73, 54, 180, 470]
target2 = 470
result2 = binary_search(sorted(arr2), target2, 0, len(arr2) - 1)
if result2 != -1:
    print(f"Binary Search: Element found at index {result2}")
else:
    print("Binary Search: Element not found")

