import numpy as np
import matplotlib.pyplot as plt
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, TensorDataset

x = np.linspace(0, 100, 1000)
data = np.sin(x)

plt.figure(figsize=(10, 4))
plt.plot(data)
plt.title("Synthetic Sine Wave")
plt.xlabel("Time")
plt.ylabel("Value")
plt.show()

def create_sequences(data, seq_length):
    xs, ys = [], []
    for i in range(len(data) - seq_length):
        x_seq = data[i:i+seq_length]
        y_seq = data[i+seq_length]
        xs.append(x_seq)
        ys.append(y_seq)
    return np.array(xs), np.array(ys)

seq_length = 50
X, y = create_sequences(data, seq_length)

X_tensor = torch.tensor(X, dtype=torch.float32).unsqueeze(-1) # shape: [batch, seq_len, 1]
y_tensor = torch.tensor(y, dtype=torch.float32).unsqueeze(-1) # shape: [batch, 1]

dataset = TensorDataset(X_tensor, y_tensor)
dataloader = DataLoader(dataset, batch_size=32, shuffle=True)

class LSTMModel(nn.Module):
    def __init__(self, input_size=1, hidden_size=64, num_layers=2, output_size=1):
        super(LSTMModel, self).__init__()
        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)
        self.linear = nn.Linear(hidden_size, output_size)

    def forward(self, x):
        lstm_out, _ = self.lstm(x)
        last_output = lstm_out[:, -1, :]
        out = self.linear(last_output)
        return out

model = LSTMModel()
criterion = nn.MSELoss()
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
epochs = 30

for epoch in range(epochs):
    for X_batch, y_batch in dataloader:
        optimizer.zero_grad()
        y_pred = model(X_batch)
        loss = criterion(y_pred, y_batch)
        loss.backward()
        optimizer.step()
    print(f"Epoch {epoch+1}/{epochs}, Loss: {loss.item():.4f}")

model.eval()
with torch.no_grad():
    test_inputs = X_tensor[-1].unsqueeze(0)
    preds = []
    for _ in range(200):
        pred = model(test_inputs)
        preds.append(pred.item())
        test_inputs = torch.cat((test_inputs[:, 1:, :], pred.unsqueeze(-1)), dim=1)

plt.figure(figsize=(10, 4))
plt.plot(range(len(data)), data, label="Original Data")
plt.plot(range(len(data), len(data) + len(preds)), preds, label="Predicted", color='red')
plt.title("LSTM Time Series Prediction")
plt.legend()
plt.show()
